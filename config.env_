VER=1.6
PASSWORD=123456
RTMPPORT=1935
SERVERREP=100
SERVERINDEX=1
NODE_ENV=deployment
USER=tue
PORT=9000

DATABASE=mongodb://localhost:27017/STREAMING_DB

JWT_SECRET=If-you_Th1NK-i_know-WH47-l-4M-DoINg-R1ghT-NoW-Y0u-ArE-DEEPly_Wrong-Pl35E-G0-Aw4y
JWT_EXPIRES_IN=90d

# --- Playback auth (nginx auth_request -> /api/auth/verify) -------------------
# off     : luôn cho qua (mặc định — giữ nguyên hành vi cũ, không làm vỡ gì)
# log     : vẫn cho qua NHƯNG đếm lại số request lẽ ra bị chặn (xem /api/auth/stats)
# enforce : chặn thật (401/403)
# Lộ trình khuyến nghị: off -> log (vài ngày, đọc stats) -> enforce.
AUTH_MODE=off
# Dung sai lệch đồng hồ Central<->Sub khi verify exp/nbf, tính bằng giây.
AUTH_CLOCK_SKEW=30
# Ghim token vào IP client (so theo /24). Bật = chống chia sẻ link, đổi lại
# người dùng chuyển 4G<->Wi-Fi giữa phiên sẽ bị đá. on|off
AUTH_BIND_IP=off
# LƯU Ý: JWT_EXPIRES_IN=90d ở trên là cho token đăng nhập. Token PHÁT VIDEO phải
# ngắn hơn rất nhiều (30s–5m) và do Central ký — TTL dài là điểm yếu lớn nhất của
# token URL vì link rò rỉ còn dùng được đúng bằng TTL đó.

CENTRAL_API=http://localhost:9000
JITTER = 10

ENCODE_TYPE = 8

# --- Logging (platform/log.js) [THÊM 2026-08-16] ------------------------------
# level : debug | info | warn | error | silent
#         Mặc định `debug` khi NODE_ENV=development, còn lại `info`.
#         Đặt `warn` khi cần cắt bớt log trên node đông người xem.
# format: json | pretty
#         Mặc định `json` khi deploy (ingest được), `pretty` khi development.
# Cùng schema với `Stream-Central-Server/backend/utils/logger.js`, để log hai
# repo query chung được một lượt theo `requestId`.
LOG_LEVEL=info
LOG_FORMAT=json

# --- Heartbeat [THÊM 2026-08-16] ----------------------------------------------
# Trước đây heartbeat chỉ chạy khi NODE_ENV=development — điều kiện NGƯỢC, nên
# node deploy không bao giờ báo cáo. Nay mặc định BẬT; đặt `off` để tắt.
HEARTBEAT_ENABLED=on
HEARTBEAT_INTERVAL_MS=10000

# --- Định danh node [THÊM 2026-08-16] -----------------------------------------
# SERVERINDEX là số thứ tự cục bộ, KHÔNG phải id toàn cục. Central định danh node
# bằng `_id` của Mongo. Để trống thì Sub tự dùng `legacy:sub-<SERVERINDEX>`.
# NODE_ID=

# --- Lưu trữ & encode [THÊM 2026-08-16] ---------------------------------------
# MEDIA_ROOT: thư mục gốc chứa media. Để trống = <repo>/videos (đúng chỗ nginx
# `:9150` đang serve). ĐỔI LÀ PHẢI ĐỔI CẢ `root` trong config nginx.
# MEDIA_ROOT=
# (STAGING_ROOT đã tách khỏi MEDIA_ROOT từ Phase 2 — xem mục "Thư mục file tạm"
#  ở cuối file.)
# Số tiến trình FFmpeg chạy song song (media/encodeQueue.js).
# Để 1 trên VM free-tier. Với NVENC, card tiêu dùng giới hạn số phiên encode
# đồng thời rất thấp và phiên vượt hạn mức LỖI KHỞI TẠO chứ không xếp hàng chờ.
ENCODE_CONCURRENCY=1

# --- Data plane [THÊM 2026-08-16 Phase 1] -------------------------------------
# Node có tự phục vụ file .m4s/.mpd/.vtt không.
# `off` (mặc định) = KHÔNG. Mọi request media tới Node nhận 410 Gone; đường phát
# duy nhất là nginx :9150. Đây là điều kiện để `auth_request` và danh sách chặn
# có ý nghĩa: còn cửa thứ hai thì cửa đó không đi qua kiểm tra nào cả.
# `on` = van xả, bật lại handler cũ khi nginx hỏng và cần phát tạm.
# Đếm số request bị từ chối: GET /api/default/data-plane
MEDIA_SERVING=off

# --- Callback kết quả encode (stream-encode-v1) [THÊM 2026-08-16 Phase 1] -----
# Sub báo ngược cho Central khi FFmpeg xong hoặc chết. Trước đây `202 Accepted`
# là tín hiệu cuối cùng Central nhận được.
#
# Endpoint phía Central đã có:  POST /api/v2/nodes/jobs/result
#   Stream-Central-Server/backend/routes/v2/nodeJobRoute.js
#   Mô tả contract: backend/contracts/encode-v1.md
#
# CENTRAL_CALLBACK_URL tách riêng khỏi CENTRAL_API dù mặc định trùng nhau:
#   CENTRAL_API          = Sub gọi Central cho việc thường (heartbeat...)
#   CENTRAL_CALLBACK_URL = kết quả encode gửi về đâu
# Tách ra để test trỏ callback vào collector cục bộ, hoặc để deploy nhiều vùng
# nơi Central có địa chỉ nội bộ khác địa chỉ public. Để trống = dùng CENTRAL_API.
CENTRAL_CALLBACK_URL=http://localhost:9000
ENCODE_CALLBACK_PATH=/api/v2/nodes/jobs/result
# Đặt `off` để job vẫn chạy và vẫn ghi .job.json nhưng không gọi ra ngoài.
ENCODE_CALLBACK=on

# --- Chặn phát [THÊM 2026-08-16 Phase 1] --------------------------------------
# Nơi lưu danh sách chặn. Để trống = <repo>/var/playback-blocks.json.
# Danh sách này CHẶN THẬT kể cả khi AUTH_MODE=off, và sống qua pm2 restart.
# API: GET/POST /api/v2/playback/blocks · DELETE /api/v2/playback/blocks/:id
#      GET /api/v2/playback/probe?uri=/videos/<key>/init.mpd  (thử trước khi chặn)
# PLAYBACK_BLOCK_STORE=

# --- Xác thực node-to-node [THÊM 2026-08-16 Phase 2] --------------------------
# Chữ ký HMAC giữa Central <-> Sub và Sub <-> Sub, và token phiên upload do
# Central ký cho FE chuyển tiếp.
#
# KHOÁ PHẢI GIỐNG HỆT ở Central (`Stream-Central-Server/backend/config.env`).
# Sinh khoá:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_SHARED_SECRET=

# off     : bỏ qua hoàn toàn (mặc định — không đổi hành vi)
# log     : vẫn cho qua NHƯNG đếm request không ký (xem /api/default/node-auth)
# enforce : chặn thật bằng 401
# LỘ TRÌNH BẮT BUỘC: off -> log (đọc /api/default/node-auth tới khi wouldDeny=0)
#                          -> enforce. Bật thẳng enforce là cắt liên lạc với
#                             mọi Central/FE chưa cập nhật.
NODE_AUTH_MODE=off

# Dung sai lệch đồng hồ giữa hai node khi kiểm timestamp, tính bằng giây.
NODE_AUTH_SKEW=300

# --- Danh tính node cho heartbeat v2 [THÊM 2026-08-16 Phase 2] ----------------
# SERVER_ID là `_id` của bản ghi `Server` trong MongoDB của Central. Đặt được nó
# thì node lên `active` ngay; thiếu thì Central suy từ PUBLIC_URL + PUBLIC_PORT,
# và nếu cũng không có thì node ở lại `suspect` MÃI dù chạy hoàn toàn bình thường.
SERVER_ID=
PUBLIC_URL=
PUBLIC_PORT=
# auto | v1 | v2 — `auto` thử v2 trước, Central cũ trả 404 thì tự hạ xuống v1.
HEARTBEAT_CONTRACT=auto

# --- Thư mục file tạm [THÊM 2026-08-16 Phase 2] -------------------------------
# Từ Phase 2, .part.N / .accepted.json / .job.json nằm ở `var/incoming/`, TÁCH
# khỏi `videos/` (thư mục nginx serve). File tạm còn sót được tự chuyển lúc boot.
# Đặt STAGING_ROOT bằng đúng MEDIA_ROOT để quay lại hành vi cũ.
# STAGING_ROOT=

# --- Fail-fast cấu hình [CẬP NHẬT 2026-08-16 Phase 2] -------------------------
# MẶC ĐỊNH GIỜ LÀ `on`: thiếu JWT_SECRET / ENCODE_TYPE / CENTRAL_API thì THOÁT
# ngay lúc boot, thay vì để lỗi nổ ra giữa lúc verify token hoặc encode — tức là
# sau khi đã nhận file của người dùng.
# Đặt `off` cho tình huống khẩn cấp cần chạy với cấu hình thiếu.
CONFIG_STRICT=on